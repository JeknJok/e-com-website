{$MAE_HOST} {
    header -Server
    @hsts expression `"{$HSTS_ENABLED:0}" == "1"`
    header @hsts {
        Strict-Transport-Security "max-age=31536000"
        defer
    }
    tls {
        protocols tls1.2 tls1.3
    }
    reverse_proxy web:8080 {
        header_up X-Forwarded-Proto https
        header_up X-Real-IP {remote_host}
        header_up Host {host}
    }
}
